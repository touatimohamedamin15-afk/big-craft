{
  "name": "buffcraft",
  "productName": "Buffcraft",
  "private": true,
  "version": "1.0.0",
  "description": "A multiplayer voxel bed-wars game with its own game server, bots, a practice sandbox and a desktop app.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev-sites.mjs",
    "build": "vite build && node scripts/postbuild.mjs",
    "start": "node dist/server/main.js",
    "desktop": "bun run build:node && bunx electron@44.6.0 .",
    "desktop:smoke": "bun run build:node && ELECTRON_SMOKE=1 bunx electron@44.6.0 .",
    "package": "bun run build:node && bunx electron-builder@26.17.0 --publish never",
    "package:dir": "bun run build:node && bunx electron-builder@26.17.0 --dir --publish never",
    "icon": "node scripts/make-icon.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "loadtest": "bun scripts/loadtest.ts",
    "smoke": "node scripts/smoke-server.mjs",
    "dev:node": "vite --config vite.node.config.ts",
    "build:node": "vite build --config vite.node.config.ts && vite build --config vite.node.config.ts --ssr src/server/main.ts --outDir dist/server",
    "smoke:sites": "node scripts/smoke-sites.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "@freebuff/auth": "0.1.0"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@types/bun": "^1.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.0",
    "three": "^0.186.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "@cloudflare/vite-plugin": "1.64.0",
    "wrangler": "4.151.0",
    "playwright": "1.58.2",
    "miniflare": "5.20261012.0-beta"
  },
  "build": {
    "appId": "com.example.buffcraft",
    "productName": "Buffcraft",
    "electronVersion": "44.6.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/node-client/**/*",
      "dist/server/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    }
  }
}
